# ==========================================
# DevPulse Capstone Task 4 Environment Configuration
# ==========================================

# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS and Cookie security)
CLIENT_URL="http://localhost:5173"

# External AI Provider Configuration (Google Gemini / OpenAI / Anthropic)
# Supported AI_PROVIDER values: "gemini", "openai", "anthropic"
AI_PROVIDER="gemini"
AI_API_KEY="your_ai_api_key_here"
AI_MODEL="gemini-3.6-flash"
